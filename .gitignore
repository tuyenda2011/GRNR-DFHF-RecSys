# Tests stay local only (not pushed to git)
test/
tests/
# ...except the test-split report, which mirrors reports/val
!reports/test/
!reports/test/tables/*.csv
# ...and the test-split results: metrics and summary only (predictions .npy stay local, re-creatable
# with scripts/evaluate_test.py)
!results/test/
!results/test/summary_test.csv
!results/test/*/d*/seed42/metrics.json

# Local validation scratch
.tmp/

# Not part of the submitted project: working notes, plans and retired code
!README.md
task_codex/
research_20261025/
third_party/
RecFlow/

# Report: publish the compiled PDF and PNG figures; keep sources and notes local
report/*
!report/main.pdf
!report/image/
