# Data & Artifacts (track manifest.json, ignore large data)
data/raw/
data/cache/
data/source/
data/versions/*
# The active build's immutable archive is tracked: train_suite pins it (same blobs as data/processed)
!data/versions/build_bed0f5b7efb9e7a0a148e2c071540e30/
data/exported/
data/.bundle.lock
!data/manifest.json
!data/current.json
artifacts/
*.log
*.pt
*.pth
*.parquet
*.pkl
*.npy
*.npz
# The processed data bundle is tracked (so a fresh clone, e.g. on Kaggle, can train directly)
!data/processed/**
!data/versions/build_bed0f5b7efb9e7a0a148e2c071540e30/**
# Results: checkpoints, training histories, and inputs used by the demo
results/**
!results/**/
!results/val/*/*/*/checkpoint.pt
!results/val/*/*/*/checkpoint.npz
!results/**/*history.csv
!results/val/summary.csv
!results/val/*/d*/seed42/metrics.json
!results/val/directau/d*/seed42/val_predictions.npy
!results/val/directau/d*/seed42/val_users.npy
!results/val/lightgcn/d*/seed42/val_predictions.npy
!results/val/lightgcn/d*/seed42/val_users.npy
!results/val/sphr/d*/seed42/val_predictions.npy
!results/val/sphr/d*/seed42/val_users.npy
!results/val/xsimgcl/d*/seed42/val_predictions.npy
!results/val/xsimgcl/d*/seed42/val_users.npy
# Reports: figures and closed-form benchmark tables used by the demo
reports/**
!reports/**/
!reports/**/*.png
!reports/*/tables/B5_closed_form.csv
!reports/*/tables/B6_closed_form_significance.csv

